<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>$(NeoTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- Neo.AssemblyForge.Core ships the storage-agnostic primitives
       (StructuredResponse, unified-diff patcher/generator, validators,
       history formatter, JSON schemata, system messages). Safe to reference
       from a netX.0-browser head because Core has no NuGet.Protocol
       transitive dep. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Neo.AssemblyForge.Core\Neo.AssemblyForge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neo.App.WebApp.Tests" />
  </ItemGroup>
</Project>
