<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything the WPF plugin window does, shared by both executable heads:
      Neo.PluginWindowWPF      – embedded child of the WPF desktop host (Neo.App)
      Neo.PluginWindowWPF.MCP  – child of Neo.McpServer (adds Smart Edit)
    Keep this library free of heavy dependencies (Roslyn, AI agents): Neo.App copies the
    slim head's entire output into its own bin folder.
  -->
  <PropertyGroup>
    <TargetFramework>$(NeoTargetFrameworkWindows)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>Neo.PluginWindowWPF</RootNamespace>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Neo.App\icon.ico" Link="Assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.IPC\Neo.IPC.csproj" />
    <ProjectReference Include="..\Neo.Shared\Neo.Shared.csproj" />
  </ItemGroup>
</Project>
