<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Thin executable head: embedded child process of the WPF desktop host (Neo.App).
    All window logic lives in Neo.PluginWindowWPF.Core. Keep this head free of heavy
    dependencies - Neo.App copies this project's entire output into its own bin folder.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NeoTargetFrameworkWindows)</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BaseOutputPath></BaseOutputPath>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.PluginWindowWPF.Core\Neo.PluginWindowWPF.Core.csproj" />
  </ItemGroup>

</Project>
