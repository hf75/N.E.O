<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(NeoTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Common" Version="7.3.1" />
    <PackageReference Include="NuGet.Packaging" Version="7.3.1" />
    <PackageReference Include="NuGet.Protocol" Version="7.3.1" />
    <PackageReference Include="NuGet.Resolver" Version="7.3.1" />
    <!-- NuGet.Packaging asks for 8.0.1 (7.9.0 too), which has two known denial-of-service holes:
         GHSA-846f-f764-76mx and GHSA-2fmv-rv2c-59x7. Every project gets the package through here. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.Agents.Core\Neo.Agents.Core.csproj" />
  </ItemGroup>

</Project>
