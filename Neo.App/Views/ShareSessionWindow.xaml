<Window x:Class="Neo.App.ShareSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share session" FontFamily="Segoe UI Semilight"
        Width="760" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Margin" Value="0,12,0,12"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <!-- A code is about five lines, and how many depends on where it has hyphens. Fixed, so the window does not jump when one arrives. -->
        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource RoundedTextBox}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Padding" Value="4,3"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameBox" Style="{StaticResource RoundedTextBox}" Grid.Column="1" ToolTip="How the others see you"/>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Invite -->
            <StackPanel>
                <TextBlock Style="{StaticResource Heading}" Text="Invite someone"/>
                <TextBlock Style="{StaticResource Hint}" Text="Each person needs their own invitation."/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="1. Invitation to send:"/>
                <TextBox x:Name="InviteOut" Style="{StaticResource CodeBox}" IsReadOnly="True"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="BtnCreateInvite" Style="{StaticResource RoundedButton}" Margin="0,0,3,0" Content="Create invitation" Click="CreateInvite_Click"/>
                    <Button x:Name="BtnCopyInvite" Style="{StaticResource RoundedButton}" Grid.Column="1" Margin="3,0,0,0" Content="Copy" IsEnabled="False" Click="CopyInvite_Click"/>
                </Grid>

                <TextBlock Style="{StaticResource FieldLabel}" Text="2. Reply code you received:"/>
                <TextBox x:Name="ReplyIn" Style="{StaticResource CodeBox}" IsEnabled="False"/>
                <Button x:Name="BtnConnect" Style="{StaticResource RoundedButton}" Margin="0,6,0,0" Content="Connect" IsEnabled="False" Click="Connect_Click"/>
            </StackPanel>

            <Border Grid.Column="1" Margin="12,0" BorderBrush="#DDD" BorderThickness="1,0,0,0"/>

            <!-- Join -->
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource Heading}" Text="Join someone's session"/>
                <TextBlock Style="{StaticResource Hint}" Text="Your current app is replaced by theirs."/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="1. Invitation you received:"/>
                <TextBox x:Name="InviteIn" Style="{StaticResource CodeBox}"/>
                <Button x:Name="BtnJoin" Style="{StaticResource RoundedButton}" Margin="0,6,0,0" Content="Create reply" Click="Join_Click"/>

                <TextBlock Style="{StaticResource FieldLabel}" Text="2. Reply code to send back:"/>
                <TextBox x:Name="ReplyOut" Style="{StaticResource CodeBox}" IsReadOnly="True"/>
                <Button x:Name="BtnCopyReply" Style="{StaticResource RoundedButton}" Margin="0,6,0,0" Content="Copy" IsEnabled="False" Click="CopyReply_Click"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource Divider}"/>

        <!-- Status -->
        <Border Padding="12,8" CornerRadius="12" Background="#F8F8F8">
            <Grid MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Not shared."/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnLeave" Style="{StaticResource RoundedButton}" Grid.Column="1" MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" Content="Leave" Visibility="Collapsed" Click="Leave_Click"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                   Text="⚠ What the others change runs as code on this PC, with your rights. Share only with people you trust. Codes go straight from PC to PC; no server of ours is involved."/>
    </StackPanel>
</Window>
