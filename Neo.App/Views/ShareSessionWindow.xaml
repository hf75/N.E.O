<Window x:Class="Neo.App.ShareSessionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share session" FontFamily="Segoe UI" FontSize="13"
        Width="600" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,14,0,4"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Code" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="MinHeight" Value="44"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="18,12,18,16">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Your name" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox x:Name="NameBox" Grid.Column="1" Padding="4" ToolTip="How the others see you"/>
        </Grid>

        <!-- Invite -->
        <TextBlock Style="{StaticResource Heading}" Text="Invite someone"/>
        <TextBlock Style="{StaticResource Hint}" Text="Create an invitation and send it to the person (chat, e-mail, …). They send you a reply code back — paste it here. Each person needs their own invitation."/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InviteOut" Style="{StaticResource Code}" IsReadOnly="True" ToolTip="The invitation"/>
            <StackPanel Grid.Column="1">
                <Button x:Name="BtnCreateInvite" Content="Create invitation" Click="CreateInvite_Click"/>
                <Button x:Name="BtnCopyInvite" Content="Copy" Margin="8,6,0,0" IsEnabled="False" Click="CopyInvite_Click"/>
            </StackPanel>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReplyIn" Style="{StaticResource Code}" IsEnabled="False" ToolTip="Paste the reply code here"/>
            <Button x:Name="BtnConnect" Grid.Column="1" Content="Connect" IsEnabled="False" Click="Connect_Click"/>
        </Grid>

        <!-- Join -->
        <TextBlock Style="{StaticResource Heading}" Text="Join someone's session"/>
        <TextBlock Style="{StaticResource Hint}" Text="Paste the invitation you received and send the reply code back. Your current app is replaced by theirs."/>
        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="InviteIn" Style="{StaticResource Code}" ToolTip="Paste the invitation here"/>
            <Button x:Name="BtnJoin" Grid.Column="1" Content="Create reply" Click="Join_Click"/>
        </Grid>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="ReplyOut" Style="{StaticResource Code}" IsReadOnly="True" ToolTip="Your reply code"/>
            <Button x:Name="BtnCopyReply" Grid.Column="1" Content="Copy" IsEnabled="False" Click="CopyReply_Click"/>
        </Grid>

        <!-- Status -->
        <Border Margin="0,16,0,0" Padding="10,8" CornerRadius="6" Background="#F3F4F6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Not shared."/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" Visibility="Collapsed" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnLeave" Grid.Column="1" Content="Leave" Visibility="Collapsed" VerticalAlignment="Center" Click="Leave_Click"/>
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                   Text="⚠ What the others change runs as code on this PC, with your rights. Share only with people you trust. Codes go straight from PC to PC; no server of ours is involved."/>
    </StackPanel>
</Window>
