<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Thin executable head: child process of Neo.McpServer. All window logic lives in
    Neo.PluginWindowWPF.Core; this head adds Smart Edit (Ctrl+K), which compiles and calls
    Claude inside the child process and therefore needs Roslyn and the agents.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NeoTargetFrameworkWindows)</TargetFramework>
    <RollForward>LatestMajor</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.PluginWindowWPF.Core\Neo.PluginWindowWPF.Core.csproj" />

    <!-- Smart Edit: Chat-Overlay + Self-Compilation -->
    <ProjectReference Include="..\Neo.Agents\Neo.Agents.Core\Neo.Agents.Core.csproj" />
    <ProjectReference Include="..\Neo.Agents\Neo.Agents.Claude\Neo.Agents.Claude.csproj" />
    <ProjectReference Include="..\Neo.Agents\Neo.Agents.CSharpDllCompile\Neo.Agents.CSharpDllCompile.csproj" />
    <ProjectReference Include="..\Neo.AssemblyForge\Neo.AssemblyForge.csproj" />
    <ProjectReference Include="..\Neo.App.Core\Neo.App.Core.csproj" />
  </ItemGroup>

</Project>
