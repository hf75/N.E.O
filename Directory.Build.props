<Project>
  <PropertyGroup>
    <!--
      The one switch for the .NET major version N.E.O. is built and tested for. Everything that
      depends on it derives from here: the target frameworks below, the build-output folder names
      the hosts look up at dev time (via the NeoTargetFramework assembly metadata, see
      Neo.Shared/NeoBuildInfo.cs), and the CI workflow's SDK version (keep that one in sync by hand).
    -->
    <NeoNetMajor>10</NeoNetMajor>
    <NeoTargetFramework>net$(NeoNetMajor).0</NeoTargetFramework>
    <NeoTargetFrameworkWindows>net$(NeoNetMajor).0-windows</NeoTargetFrameworkWindows>
    <NeoTargetFrameworkBrowser>net$(NeoNetMajor).0-browser</NeoTargetFrameworkBrowser>

    <!--
      Runtime policy for every executable: run on the major we build for; if that one is not
      installed but a newer major is (a machine that only has .NET 11), use the newer one.
      Deliberately not LatestMajor: the hosts compile generated code against the runtime they
      run on and stamp that major into exported apps, so with 10 and 11 side by side we want the
      tested LTS runtime, not whatever happens to be newest.
    -->
    <RollForward>Major</RollForward>

    <!--
      The one switch for the Avalonia version: every Avalonia PackageReference in the repo uses
      it, and the prompts/tools that tell an AI which version to write code for read it back from
      the NeoAvaloniaVersion assembly metadata (Neo.Shared/NeoBuildInfo.cs). Generated code is
      compiled against, and runs on, the Avalonia assemblies the hosts ship, so there must never
      be a second place that spells this number.
      Avalonia.Controls.WebView (the official NativeWebView) is released on its own cadence.
    -->
    <NeoAvaloniaVersion>12.1.2</NeoAvaloniaVersion>
    <NeoAvaloniaWebViewVersion>12.1.0</NeoAvaloniaWebViewVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="NeoTargetFramework" Value="$(NeoTargetFramework)" />
    <AssemblyMetadata Include="NeoAvaloniaVersion" Value="$(NeoAvaloniaVersion)" />
  </ItemGroup>
</Project>
