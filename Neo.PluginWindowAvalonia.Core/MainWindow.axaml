<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Neo.PluginWindowAvalonia.MainWindow"
        Title="NwCreatePluginWindowAvalonia" WindowDecorations="None" Width="0" Height="0">
<Grid>
        <ContentControl x:Name="dynamicContent" />

        <!-- Wait overlay: shown when no control is loaded -->
        <Border x:Name="WaitOverlay" Background="#F8F8F8" IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="N.E.O." FontSize="32" FontWeight="Bold"
                           Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WaitStatusText" Text="Waiting for code..."
                           FontSize="16" Foreground="#AAA" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WaitTimerText" Text=""
                           FontSize="22" FontFamily="Consolas, 'Cascadia Mono', monospace"
                           Foreground="#BBB" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Another program is being dragged over this one: dropping it merges the two -->
        <Border x:Name="FusionOverlay" IsVisible="False" IsHitTestVisible="False" Background="#401565C0" BorderBrush="#1565C0" BorderThickness="4" ZIndex="200">
            <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24,16" Padding="20,10" CornerRadius="18" Background="#E01565C0">
                <TextBlock x:Name="FusionText" Foreground="White" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
            </Border>
        </Border>

        <!-- One-line hint over the app, e.g. how to call N.E.O. up in a living app; goes away by itself or on click -->
        <Border x:Name="HintBanner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="0,0,0,18" Padding="14,8" CornerRadius="16" Background="#D0202020" ZIndex="100">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13"/>
        </Border>

</Grid>
</Window>
