<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Neo.PluginWindowAvalonia.MainWindow"
        Title="NwCreatePluginWindowAvalonia" WindowDecorations="None" Width="0" Height="0">
<Grid>
        <ContentControl x:Name="dynamicContent" />

        <!-- Wait overlay: shown when no control is loaded -->
        <Border x:Name="WaitOverlay" Background="#F8F8F8" IsVisible="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                <TextBlock Text="N.E.O." FontSize="32" FontWeight="Bold"
                           Foreground="#888" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WaitStatusText" Text="Waiting for code..."
                           FontSize="16" Foreground="#AAA" HorizontalAlignment="Center"/>
                <TextBlock x:Name="WaitTimerText" Text=""
                           FontSize="22" FontFamily="Consolas, 'Cascadia Mono', monospace"
                           Foreground="#BBB" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Another program is being dragged over this one: dropping it on the left merges the two, on the right links them -->
        <Grid x:Name="FusionOverlay" IsVisible="False" IsHitTestVisible="False" ColumnDefinitions="*,*" ZIndex="200">
            <Border x:Name="MergeZone" BorderBrush="#1565C0">
                <Border x:Name="MergePill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16" Padding="16,10" CornerRadius="18" Background="#1565C0">
                    <TextBlock x:Name="FusionText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Border>
            <Border x:Name="LinkZone" Grid.Column="1" BorderBrush="#00796B">
                <Border x:Name="LinkPill" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,16" Padding="16,10" CornerRadius="18" Background="#00796B">
                    <TextBlock x:Name="LinkText" Foreground="White" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
                </Border>
            </Border>
        </Grid>

        <!-- Alt held: the part under the pointer, which dragged out of the window with Alt becomes a program of its own -->
        <Canvas x:Name="TearLayer" IsHitTestVisible="False" ZIndex="250">
            <Border x:Name="TearTarget" IsVisible="False" BorderBrush="#7B1FA2" BorderThickness="3" Background="#207B1FA2" CornerRadius="4"/>
            <Border x:Name="TearPill" IsVisible="False" Padding="10,5" CornerRadius="12" Background="#E07B1FA2">
                <TextBlock Text="Drag it out with Alt: a program of its own" Foreground="White" FontSize="12"/>
            </Border>
        </Canvas>

        <!-- The app links of this window: each says with whom, and ends with a click on its cross -->
        <StackPanel x:Name="LinkChips" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="4" ZIndex="150"/>

        <!-- One-line hint over the app, e.g. how to call N.E.O. up in a living app; goes away by itself or on click -->
        <Border x:Name="HintBanner" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Margin="8,0,8,18" Padding="14,8" CornerRadius="16" Background="#D0202020" ZIndex="100">
            <TextBlock x:Name="HintText" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
        </Border>

        <!-- Another app or Claude wants this app to change something: the person says whether it may -->
        <Border x:Name="ConsentStrip" IsVisible="False" VerticalAlignment="Bottom" Margin="8" Padding="12,10"
                CornerRadius="10" Background="#F2263238" ZIndex="300">
            <StackPanel Spacing="8">
                <TextBlock x:Name="ConsentText" Foreground="White" FontSize="13" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="ConsentAllow" Content="Allow" Margin="0,0,6,4"/>
                    <Button x:Name="ConsentAlways" Margin="0,0,6,4"/>
                    <Button x:Name="ConsentDeny" Content="No" Margin="0,0,6,4"/>
                </WrapPanel>
            </StackPanel>
        </Border>

</Grid>
</Window>
