<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Everything the Avalonia plugin window does, shared by both executable heads:
      Neo.PluginWindowAvalonia      – child of the desktop hosts (Neo.App, Neo.App.Avalonia)
      Neo.PluginWindowAvalonia.MCP  – child of Neo.McpServer (adds Smart Edit)
    Keep this library free of heavy dependencies (Roslyn, AI agents): Neo.App copies the
    slim head's entire output into its own bin folder.
  -->
  <PropertyGroup>
    <TargetFramework>$(NeoTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>Neo.PluginWindowAvalonia</RootNamespace>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(NeoAvaloniaVersion)" />
    <!-- The official NativeWebView (WebView2 / WKWebView / WebKitGTK). Part of the child runtime on
         purpose: generated apps get a browser control without a NuGet download, and it always
         matches the Avalonia version they run on. -->
    <PackageReference Include="Avalonia.Controls.WebView" Version="$(NeoAvaloniaWebViewVersion)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\Neo.App\icon.ico" Link="Assets\icon.ico" LogicalName="icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Neo.IPC\Neo.IPC.csproj" />
    <ProjectReference Include="..\Neo.Shared\Neo.Shared.csproj" />
    <ProjectReference Include="..\Neo.App.Api\Neo.App.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Neo.PluginWindowAvalonia.Core.Tests" />
  </ItemGroup>
</Project>
