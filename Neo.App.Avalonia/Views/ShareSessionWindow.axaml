<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Neo.App.Views.ShareSessionWindow"
        Title="Share session"
        FontFamily="Inter, Segoe UI, sans-serif"
        Width="760"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>
        <Style Selector="Border.divider">
            <Setter Property="Margin" Value="0,12,0,12"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <!-- A code is about five lines, and how many depends on where it has hyphens. Fixed, so the window does not jump when one arrives. -->
        <Style Selector="TextBox.code">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="Height" Value="90"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style Selector="Button.wide">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </Window.Styles>

    <StackPanel Margin="16">
        <Grid ColumnDefinitions="Auto,*">
            <TextBlock Text="Your name:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="NameBox" Classes="rounded" Grid.Column="1" Padding="4" Watermark="how the others see you"/>
        </Grid>

        <Border Classes="divider"/>

        <Grid ColumnDefinitions="*,Auto,*">
            <!-- Invite -->
            <StackPanel>
                <TextBlock Classes="heading" Text="Invite someone"/>
                <TextBlock Classes="hint" Text="Each person needs their own invitation."/>

                <TextBlock Classes="fieldLabel" Text="1. Invitation to send:"/>
                <TextBox x:Name="InviteOut" Classes="rounded code" IsReadOnly="True" Watermark="the invitation appears here"/>
                <Grid ColumnDefinitions="*,*" Margin="0,6,0,0">
                    <Button x:Name="BtnCreateInvite" Classes="rounded wide" Margin="0,0,3,0" Content="Create invitation" Click="CreateInvite_Click"/>
                    <Button x:Name="BtnCopyInvite" Classes="rounded wide" Grid.Column="1" Margin="3,0,0,0" Content="Copy" IsEnabled="False" Click="CopyInvite_Click"/>
                </Grid>

                <TextBlock Classes="fieldLabel" Text="2. Reply code you received:"/>
                <TextBox x:Name="ReplyIn" Classes="rounded code" Watermark="paste the reply code here" IsEnabled="False"/>
                <Button x:Name="BtnConnect" Classes="rounded wide" Margin="0,6,0,0" Content="Connect" IsEnabled="False" Click="Connect_Click"/>
            </StackPanel>

            <Border Grid.Column="1" Margin="12,0" BorderBrush="#DDD" BorderThickness="1,0,0,0"/>

            <!-- Join -->
            <StackPanel Grid.Column="2">
                <TextBlock Classes="heading" Text="Join someone's session"/>
                <TextBlock Classes="hint" Text="Your current app is replaced by theirs."/>

                <TextBlock Classes="fieldLabel" Text="1. Invitation you received:"/>
                <TextBox x:Name="InviteIn" Classes="rounded code" Watermark="paste the invitation here"/>
                <Button x:Name="BtnJoin" Classes="rounded wide" Margin="0,6,0,0" Content="Create reply" Click="Join_Click"/>

                <TextBlock Classes="fieldLabel" Text="2. Reply code to send back:"/>
                <TextBox x:Name="ReplyOut" Classes="rounded code" IsReadOnly="True" Watermark="your reply code appears here"/>
                <Button x:Name="BtnCopyReply" Classes="rounded wide" Margin="0,6,0,0" Content="Copy" IsEnabled="False" Click="CopyReply_Click"/>
            </StackPanel>
        </Grid>

        <Border Classes="divider"/>

        <!-- Status -->
        <Border Padding="12,8" CornerRadius="12" Background="#F8F8F8">
            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Not shared."/>
                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#B42318" IsVisible="False" Margin="0,4,0,0"/>
                </StackPanel>
                <Button x:Name="BtnLeave" Classes="rounded" Grid.Column="1" MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="Leave" IsVisible="False" Click="Leave_Click"/>
            </Grid>
        </Border>

        <!-- Teleport -->
        <Border x:Name="TeleportPanel" Padding="12,8" Margin="0,8,0,0" CornerRadius="12" Background="#F8F8F8" IsVisible="False">
            <Grid ColumnDefinitions="*,Auto,Auto" MinHeight="32">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Classes="heading" Text="Teleport the running app"/>
                    <TextBlock x:Name="TeleportText" Classes="hint"/>
                </StackPanel>
                <ComboBox x:Name="TeleportTo" Grid.Column="1" MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center"/>
                <Button x:Name="BtnTeleport" Classes="rounded" Grid.Column="2" MinWidth="120" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalContentAlignment="Center" Content="Teleport" Click="Teleport_Click"/>
            </Grid>
        </Border>

        <TextBlock Classes="hint" Margin="0,8,0,0"
                   Text="⚠ What the others change runs as code on this PC, with your rights. Share only with people you trust. Codes go straight from PC to PC; no server of ours is involved."/>
    </StackPanel>
</Window>
