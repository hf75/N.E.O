<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>$(NeoTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Desktop" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="$(NeoAvaloniaVersion)" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="$(NeoAvaloniaVersion)" />
    <!-- The microphone (waveIn), 16 kHz mono for the speech recognition. -->
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- The brain: a live Claude Code session. -->
    <ProjectReference Include="..\Neo.ClaudeAgent\Neo.ClaudeAgent.csproj" />
  </ItemGroup>
</Project>
